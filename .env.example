# ============================================================================
# KanbaLeiando - variaveis de ambiente (secao 16.3 da especificacao)
# Copie para .env e preencha. O .env NUNCA e versionado nem entra na imagem.
# Valores aqui sao ilustrativos/placeholders, sem credenciais funcionais.
# ============================================================================

# --- Ambiente e rede ---
APP_ENV=development                     # development | test | staging | production
APP_BASE_URL=http://localhost:8080      # URL publica HTTPS usada nos links de e-mail
APP_TIMEZONE=America/Sao_Paulo
PORT=8080

# --- Projeto Google / Firebase ---
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_SERVICE_ACCOUNT_ID=sua-conta@seu-projeto.iam.gserviceaccount.com

# Valores PUBLICOS do Firebase Web (podem chegar ao cliente via /config).
FIREBASE_WEB_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_WEB_APP_ID=1:000000000000:web:0000000000000000000000

# --- Storage de anexos (bucket privado) ---
GCS_BUCKET_NAME=kanbaleiando-anexos

# --- Admin (SECRETOS) ---
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_SESSION_SECRET=gerar-segredo-de-alta-entropia
ADMIN_SESSION_TTL_SECONDS=3600

# --- Link publico (SECRETO; a rotacao invalida links existentes) ---
PUBLIC_LINK_SECRET=gerar-outro-segredo-de-alta-entropia

# --- SMTP (SECRETOS; apenas no backend) ---
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=usuario-smtp
SMTP_PASSWORD=senha-smtp
SMTP_FROM=KanbaLeiando <naoresponda@seudominio.com>
SMTP_USE_TLS=true

# --- Cloud Tasks (tarefas finitas) ---
CLOUD_TASKS_LOCATION=southamerica-east1
CLOUD_TASKS_QUEUE=kanbaleiando-tasks
TASKS_SERVICE_ACCOUNT_EMAIL=tasks@seu-projeto.iam.gserviceaccount.com
TASKS_AUDIENCE=https://sua-url-do-cloud-run/api/v1/internal/tasks

# --- Limites ---
MAX_UPLOAD_BYTES=20000000               # 20 MB decimais, inclusivo
PREVIEW_TIMEOUT_SECONDS=45

# --- CORS (apenas desenvolvimento) ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Emuladores (APENAS desenvolvimento/testes; nunca em producao) ---
# FIRESTORE_EMULATOR_HOST=localhost:8081
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# STORAGE_EMULATOR_HOST=localhost:9199
