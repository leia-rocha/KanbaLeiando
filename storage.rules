rules_version = '2';

// Bucket privado do KanbaLeiando (secao 8.1, 16.4).
// Nenhum acesso direto pelo cliente: upload e download usam URLs assinadas
// emitidas pela API. O bucket nunca e publico.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
